---
import '../styles/global.css';
import { INDEXABLE, SITE, SITE_URL, NAV, FOOTER_NAV } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Seite nie indexieren lassen (z. B. 404). */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${SITE.name}` : SITE.titleDefault;
const path = Astro.url.pathname;
const robotsNoindex = noindex || !INDEXABLE;
const current = (href: string) => !href.includes('#') && path === url(href);
const canonical = SITE_URL + path;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonical,
  inLanguage: 'de',
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
    inLanguage: 'de',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <meta name="generator" content={Astro.generator} />
    <!-- Kein Favicon: Das Bildmarken-Favicon ist noch nicht freigegeben. -->
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={url('/')}>
          <img src={url('/brand/paolo-sms-logo.svg')} alt="PAOLO SMS – zur Startseite" width="217" height="60" />
        </a>
        <nav class="nav" aria-label="Hauptnavigation">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            <li><a class="btn" href={`mailto:${SITE.email}`}>Kontakt</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Fußnavigation">
          <ul>
            {FOOTER_NAV.map((item) => (
              <li><a href={url(item.href)}>{item.label}</a></li>
            ))}
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
        </nav>
        <p>PAOLO SMS – Pilot Awareness and Occurrence Learning Online. Software unter GPL-3.0-or-later.</p>
        <p class="small">Name und Logo sind vom Lizenzrecht ausgenommen und gesondert vorbehalten. Diese Website ist die Projektseite; PAOLO-Installationen werden von Vereinen und Flugschulen eigenständig betrieben. Stand: {SITE.stand}.</p>
      </div>
    </footer>
  </body>
</html>
