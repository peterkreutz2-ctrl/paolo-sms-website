---
import Base from '../layouts/Base.astro';
import Saeulen from '../components/Saeulen.astro';
import Risikomanagement from '../components/Risikomanagement.astro';
import Praxisbeispiel from '../components/Praxisbeispiel.astro';
import Unreleased from '../components/Unreleased.astro';
import { SITE } from '../config';
import { url } from '../lib/url';

const shots = [
  {
    t: 'Meldeformular',
    d: 'Meldung ohne Anmeldung einreichen: wenige Pflichtfelder, auf Wunsch anonym.',
    src: '/bilder/meldung-einreichen.png',
    w: 840,
    h: 987,
    alt: 'Illustration des öffentlichen Meldeformulars „Sicherheitsmeldung einreichen“: links Hinweise (nicht zurechtweisend, kein offizieller Bericht, anonym möglich), rechts die Felder Art der Meldung, Kurzbeschreibung und ausführliche Beschreibung.',
  },
  {
    t: 'Dashboard',
    d: 'Überblick über neue Meldungen sowie offene und überfällige Maßnahmen.',
    src: '/bilder/dashboard.png',
    w: 944,
    h: 720,
    alt: 'Illustration des Dashboards: Hinweis zur nächsten Sicherheitsbesprechung, Kennzahlen zu Meldungen (neue, in Prüfung, kritische, offene) und zu Maßnahmen (offene, überfällige).',
  },
  {
    t: 'Meldung bewerten',
    d: 'Meldungsdetail mit Priorität und Risikobewertung nach Risikomatrix.',
    src: '/bilder/meldung-klassifizieren.png',
    w: 390,
    h: 720,
    alt: 'Illustration einer Meldung in der Bearbeitung: Meldungsdaten, Angaben zur meldenden Person und Klassifizierung mit Risikobewertung nach Risikomatrix aus Eintrittswahrscheinlichkeit und Schweregrad.',
  },
  {
    t: 'Maßnahmen',
    d: 'Maßnahmenliste mit Verantwortlichen, Fälligkeitsdatum und Status.',
    src: '/bilder/massnahmen.png',
    w: 388,
    h: 720,
    alt: 'Illustration einer Meldung mit Maßnahme: vorhandene Maßnahme mit Status, Fälligkeitsdatum und Verantwortlichem sowie Formular zum Anlegen einer neuen Maßnahme.',
  },
];
---

<Base>
  <!-- A. Kopfbereich -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Melden. Verstehen. Verbessern.</p>
        <h1 id="h-hero">PAOLO macht Sicherheitsmanagement einfach.</h1>
        <p class="acronym"><strong><span class="acronym__name">PAOLO</span> SMS</strong> – <span lang="en"><span class="acronym__l">P</span>ilot <span class="acronym__l">A</span>wareness and <span class="acronym__l">O</span>ccurrence <span class="acronym__l">L</span>earning <span class="acronym__l">O</span>nline</span></p>
        <p class="subtitle">Sicherheit wird zu einem Teil des täglichen Betriebs.</p>
        <p class="lead">
          PAOLO SMS ist freie Software, die Gleitschirmvereine und Flugschulen beim Aufbau und Betrieb ihres Sicherheits&shy;management&shy;systems unterstützt: mit einem klaren Ablauf und fertigen Vorlagen, um Beobachtungen zu erfassen, einzuschätzen und daraus Maßnahmen abzuleiten.
        </p>
        <div class="btn-row">
          <a class="btn" href="#saeulen">So funktioniert es</a>
          <a class="btn btn--ghost" href={url('/einfuehren/')}>Für Verein oder Flugschule</a>
          <a class="btn btn--ghost" href="https://paolo-sms-demo.vercel.app" rel="noopener">Demo ausprobieren</a>
        </div>
        <p class="small">Probiere PAOLO mit erfundenen Beispieldaten selbst aus: Die Demo wird täglich zurückgesetzt, die Zugangsdaten stehen auf ihrer Anmeldeseite. Bitte gib dort keine echten Daten ein.</p>
        <p class="small muted">Unentgeltlich als Gemeinschaftsprojekt. Lizenz: GPL-3.0-or-later.</p>
      </div>
    </div>
  </section>

  <!-- B. Worum geht es? Die vier Säulen eines SMS -->
  <section class="section" id="saeulen" aria-labelledby="h-sms">
    <div class="wrap">
      <h2 id="h-sms">Was ist ein Sicherheits&shy;management&shy;system?</h2>
      <p class="lead">
        Ein Sicherheits&shy;management&shy;system ist mehr als ein Meldeverfahren. Es schafft Struktur und Prozesse für die kontinuierliche Verbesserung der Sicherheitskultur.
      </p>
      <p>Dabei geht es um Verständnis und Verbesserung, nicht um Schuld.</p>
      <p class="muted small">SMS steht hier für Safety Management System, nicht für Kurznachrichten.</p>
      <Saeulen />
      <div class="callout">
        <h3>Deine Organisation gestaltet das SMS – PAOLO unterstützt dabei.</h3>
        <p>
          Das Sicherheits&shy;management&shy;system ist das organisatorische Managementsystem deines Vereins oder deiner Flugschule. Sicherheitsrichtlinie, Rollen, Entscheidungen, Schulung und gelebte Sicherheitskultur liegen bei deiner Organisation.
        </p>
        <p>
          PAOLO unterstützt dich bei der Einführung und beim laufenden Betrieb deines SMS. Die Software bietet dafür strukturierte Prozesse, praktische Werkzeuge und eine zentrale Dokumentation. Die Verantwortung für das Sicherheitsmanagement bleibt bei deiner Organisation.
        </p>
      </div>
    </div>
  </section>

  <!-- D. Teamarbeit -->
  <section class="section" id="team" aria-labelledby="h-team">
    <div class="wrap">
      <h2 id="h-team">Sicherheit ist Teamarbeit</h2>
      <p class="lead">Ein Sicherheits&shy;management&shy;system funktioniert nur, wenn alle ihren Teil beitragen.</p>
      <ul class="cards cards--3">
        <li class="card" style="--accent: var(--orange)">
          <h3>Accountable Executive</h3>
          <p class="role">Gesamtverantwortung</p>
          <ul>
            <li>Sicherheit ist Chefsache.</li>
            <li>Stellt Ressourcen bereit.</li>
            <li>Schafft die Voraussetzungen für eine Redlichkeitskultur (Just Culture).</li>
          </ul>
          <p class="small muted">Im Verein üblicherweise der Vorstand, in der Flugschule die Schulleitung.</p>
        </li>
        <li class="card" style="--accent: var(--yellow)">
          <h3>Safety Manager</h3>
          <p class="role">Koordination</p>
          <ul>
            <li>Organisiert die Sicherheitsarbeit.</li>
            <li>Berät und moderiert.</li>
            <li>Ist Schnittstelle zum Management.</li>
          </ul>
        </li>
        <li class="card" style="--accent: var(--green)">
          <h3>Team</h3>
          <p class="role">Sicherheitskultur</p>
          <ul>
            <li>Meldet ohne Angst vor Strafe oder Blamage.</li>
            <li>Lernt aus Erfahrungen.</li>
            <li>Trägt Verbesserungen mit.</li>
          </ul>
        </li>
      </ul>
      <p><a href={url('/einfuehren/#rollen')}>Die Rollen in PAOLO im Überblick</a></p>
      <Unreleased>
        Der Flyer verwendet „Accountable Manager" und „Just Culture". Hier gelten die Begriffe der Projekt-Terminologie: „Accountable Executive" und „Redlichkeitskultur (Just Culture)". Der Flyer wird angeglichen.
      </Unreleased>
    </div>
  </section>

  <!-- Risikomanagement -->
  <section class="section" id="risikomanagement" aria-labelledby="h-risiko">
    <div class="wrap">
      <h2 id="h-risiko">Risikomanagement – die Kernfunktion von PAOLO</h2>
      <p class="lead">
        Risikomanagement ist eine der vier Säulen deines Sicherheits&shy;management&shy;systems, und genau diesen Prozess unterstützt PAOLO am stärksten. Er ist ein Kreislauf aus vier Schritten, der nie abgeschlossen ist: Erkennen, Bewerten, Mindern, Kommunizieren.
      </p>
      <Risikomanagement />
      <div class="callout">
        <h3>Ein durchgängiger Ablauf an einem Ort</h3>
        <p>
          In PAOLO führt jede Meldung ohne Medienbruch von der ersten Beobachtung über die Bewertung und die Maßnahme bis zur Information des Teams. Rollen, Fristen und Status bleiben dabei nachvollziehbar. Die Entscheidungen treffen weiterhin die Menschen in deiner Organisation.
        </p>
      </div>
      <Unreleased>
        Neuer Abschnitt. Die Formulierung „Kernfunktion“ und die Schrittnamen sind noch nicht freigegeben.
      </Unreleased>
    </div>
  </section>

  <!-- Risikomanagement in der Praxis -->
  <section class="section section--praxis" id="praxisbeispiel" aria-labelledby="h-praxis">
    <div class="wrap">
      <h2 id="h-praxis">Risikomanagement in der Praxis – ein Beispiel</h2>
      <p class="lead">
        Das Beispiel eines Risikos durch eine zu hohe Hecke im Abflugbereich des Vereinsstartplatzes zeigt, wie die vier Schritte im Alltag ineinandergreifen.
      </p>
      <Praxisbeispiel />
      <Unreleased>
        Neuer Abschnitt mit erfundenem Beispiel. Szenario, Formulierungen und die Darstellung des Zeitablaufs sind noch nicht freigegeben.
      </Unreleased>
    </div>
  </section>

  <!-- E. Einblicke -->
  <section class="section section--alt" id="einblicke" aria-labelledby="h-einblicke">
    <div class="wrap">
      <h2 id="h-einblicke">So sieht PAOLO aus</h2>
      <p class="lead">Die Bilder sind anonymisierte, vereinfachte Illustrationen. Sie zeigen die wesentlichen Funktionen, entsprechen aber nicht exakt der Benutzeroberfläche.</p>
      <div class="shots wide">
        {shots.map((s) => (
          <figure class="shot">
            <div class="shot__frame">
              <img src={url(s.src)} alt={s.alt} width={s.w} height={s.h} style={`--w:${s.w}px`} loading="lazy" decoding="async" />
            </div>
            <figcaption><strong>{s.t}.</strong> {s.d}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- F. Verein und Flugschule -->
  <section class="section" id="organisationen" aria-labelledby="h-org">
    <div class="wrap">
      <h2 id="h-org">Für deine Organisation</h2>
      <p class="lead">Beide nutzen dieselben Rollen, denselben Ablauf und dieselben Dokumentvorlagen. Unterschiede liegen im Alltag.</p>
      <div class="cards cards--2">
        <article class="card" style="--accent: var(--blue)">
          <h3>Verein</h3>
          <ul>
            <li>Der Vorstand trägt die Gesamtverantwortung.</li>
            <li>Beobachtungen zu Fluggelände, Startplätzen und Vereinsbetrieb lassen sich zentral erfassen.</li>
            <li>Der Safety Manager koordiniert; eine Vertretung ist möglich.</li>
          </ul>
        </article>
        <article class="card" style="--accent: var(--blue)">
          <h3>Flugschule</h3>
          <ul>
            <li>Die Schulleitung trägt die Gesamtverantwortung.</li>
            <li>Erfahrene Fluglehrer können als Safety Assistant mitarbeiten.</li>
            <li>Meldungen lassen sich nach Aktivitätsart einordnen, etwa Grundausbildung, Höhenflugausbildung oder Sicherheitstraining.</li>
          </ul>
        </article>
      </div>
      <p><a href={url('/einfuehren/')}>Einführung und Betrieb</a></p>
      <Unreleased>Entwurf. Die fachliche Bestätigung durch Vertreter von Verein und Flugschule steht aus.</Unreleased>
    </div>
  </section>

  <!-- G. Eigene Installation -->
  <section class="section section--alt" id="betrieb" aria-labelledby="h-betrieb">
    <div class="wrap">
      <h2 id="h-betrieb">Jede Organisation betreibt ihr eigenes PAOLO</h2>
      <p class="lead">
        PAOLO SMS ist keine zentrale Plattform. Dein Verein oder deine Flugschule betreibt eine eigene Installation, selbst oder mit einem IT-Dienstleister. Deine Organisation entscheidet, wo die Daten liegen, und verantwortet Datenschutz, Zugänge, Updates und Backups. Die Software ist unentgeltlich. Je nach Betriebsweise können Kosten für Hosting oder Dienste entstehen.
      </p>
      <p>Meldungen gibst du in der Installation deiner Organisation ab, nicht auf dieser Website.</p>
      <p><a href={url('/einfuehren/#betrieb')}>Betriebswege im Überblick</a> · <a href={url('/materialien/')}>Factsheet, Vorstellung und Leitfäden</a></p>
    </div>
  </section>

  <!-- H. Stand und Grenzen -->
  <section class="section" id="stand" aria-labelledby="h-stand">
    <div class="wrap">
      <h2 id="h-stand">Stand und Grenzen</h2>
      <div class="cards cards--2">
        <div class="card" style="--accent: var(--petrol)">
          <h3>Entwicklungsstand</h3>
          <p>PAOLO SMS befindet sich in der Pilotphase und ist für kleine, bekannte Gruppen ausgelegt. Stand: {SITE.stand}.</p>
          <h3>Funktionsumfang</h3>
          <ul class="tick">
            <li>Anonymes Meldeformular ohne Anmeldung</li>
            <li>Bewertung mit Risikomatrix</li>
            <li>Maßnahmen mit Fristen</li>
            <li>Sicherheitsbesprechungen</li>
            <li>SMS-Dokumente mit Vorlagen</li>
            <li>Rollen und Zugriffsrechte</li>
            <li>Datenschutzwerkzeuge und Audit-Log</li>
            <li>Backups</li>
          </ul>
        </div>
        <div class="card" style="--accent: var(--orange)">
          <h3>Grenzen</h3>
          <ul>
            <li>Eine Organisation je Installation, keine zentrale Plattform.</li>
            <li>PAOLO ersetzt keine Meldung an den DHV über FIDA und keine anderen gesetzlich vorgeschriebenen Meldungen.</li>
          </ul>
          <p>Weitere Einzelheiten zum Stand erhältst du <a href={`mailto:${SITE.email}`}>auf Anfrage</a>.</p>
        </div>
      </div>
      <Unreleased>
        Belege zum Entwicklungsstand werden mit den freigegebenen Dokumenten ergänzt (siehe „Informationen &amp; Materialien"). Die Formulierung „Pilotphase" wird abgestimmt.
      </Unreleased>
    </div>
  </section>

  <!-- I. Kontakt -->
  <section class="section section--alt" id="kontakt" aria-labelledby="h-kontakt">
    <div class="wrap">
      <h2 id="h-kontakt">Interesse an der Pilotphase?</h2>
      <p class="lead">
        Schreib uns an <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Wir sprechen über deinen Bedarf, den Betrieb und die nächsten Schritte. Rückmeldungen aus der Praxis helfen uns, PAOLO zu verbessern.
      </p>
      <p>Quellcode und Dokumentation sind während der Pilotphase auf Anfrage erhältlich.</p>
      <div class="btn-row">
        <a class="btn" href={`mailto:${SITE.email}`}>E-Mail schreiben</a>
        <a class="btn btn--ghost" href={url('/mitmachen/')}>Mitmachen</a>
      </div>
      <p><strong>Mit PAOLO wird Sicherheitsmanagement einfach und nachvollziehbar.</strong></p>
      <Unreleased>
        Der Flyer schließt mit „einfach, nachvollziehbar und wirksam". „Wirksam" ist ein Wirkungsversprechen und hier vorerst weggelassen; der Schlusssatz wird abgestimmt.
      </Unreleased>
    </div>
  </section>
</Base>
