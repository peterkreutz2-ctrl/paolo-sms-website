---
import Base from '../layouts/Base.astro';
import InstallationPrompt from '../components/InstallationPrompt.astro';
import MaterialCard from '../components/MaterialCard.astro';
import ReleaseDownload from '../components/ReleaseDownload.astro';
import { groups, materials, MATERIAL_LICENSE } from '../data/materials';
import { SITE } from '../config';
import { url } from '../lib/url';
---

<Base title="Informationen & Materialien" description="Factsheet, Vorstellung, Leitfäden und Video zu PAOLO SMS, geordnet nach Zielgruppe und Verwendungszweck.">
  <section class="section" aria-labelledby="h-mat">
    <div class="wrap">
      <p class="eyebrow">Informationen &amp; Materialien</p>
      <h1 id="h-mat">Material zum Kennenlernen, Vorstellen und Einführen</h1>
      <p class="lead">
        Hier findest du Material, um PAOLO kennenzulernen, im Verein oder in der Flugschule vorzustellen und eine Einführung vorzubereiten. Jedes Dokument nennt Version und Stand.
      </p>
      <p class="muted small">
        Gekennzeichnet ist, ob ein Material zum <strong>Download</strong> bereitsteht, über einen <strong>externen Link</strong> erreichbar ist, <strong>nur in der Anwendung</strong> zugänglich ist, <strong>auf Anfrage</strong> erhältlich ist oder noch <strong>in Vorbereitung</strong> ist.
      </p>
    </div>
  </section>

  {groups.map((g, i) => (
    <>
    {g.id === 'vorstellen' && (
      <section class="section section--ruled" id="ausprobieren" aria-labelledby="h-ausprobieren">
        <div class="wrap">
          <h2 id="h-ausprobieren">PAOLO ausprobieren</h2>
          <p class="lead">Du möchtest PAOLO SMS selbst kennenlernen? In unserem öffentlich zugänglichen Demosystem kannst du die Anwendung ausprobieren und ihre wichtigsten Funktionen erkunden.</p>
          <div class="btn-row">
            <a class="btn" href="https://demo.paolo-sms.de/" target="_blank" rel="noopener noreferrer">Demosystem öffnen<span class="visually-hidden"> (öffnet in neuem Tab)</span></a>
          </div>
        </div>
      </section>
    )}
    <section class={`section ${i % 2 === 0 ? 'section--alt' : ''}`} id={g.id} aria-labelledby={`h-${g.id}`}>
      <div class="wrap">
        <h2 id={`h-${g.id}`}>{g.title}</h2>
        <p class="muted">{g.audience}</p>
        {g.id === 'technik' && (
          <>
            <ReleaseDownload />
            <InstallationPrompt />
          </>
        )}
        <ul class="cards cards--2">
          {materials.filter((m) => m.group === g.id).map((m) => <MaterialCard item={m} />)}
        </ul>
      </div>
    </section>
    </>
  ))}

  <section class="section" id="versionen" aria-labelledby="h-versionen">
    <div class="wrap">
      <h2 id="h-versionen">Versionen und Änderungen</h2>
      <p>Jedes veröffentlichte Dokument nennt Version und Datum. Die Tabelle nennt die Änderung gegenüber der vorherigen Fassung; frühere Fassungen sind nicht mehr abrufbar.</p>
      <div class="table-wrap">
        <table>
          <caption>Veröffentlichte Dokumente</caption>
          <thead><tr><th scope="col">Dokument</th><th scope="col">Version</th><th scope="col">Datum</th><th scope="col">Änderung</th></tr></thead>
          <tbody>
            <tr><td>Factsheet</td><td>1.5</td><td>27.11.2026</td><td>Lizenzhinweis CC BY 4.0 und Namensnennung ergänzt</td></tr>
            <tr><td>Factsheet</td><td>1.4</td><td>18.11.2026</td><td>Verweis auf das Quellpaket statt auf ein Repository, „freies" statt „Open-Source", Schreibfehler korrigiert</td></tr>
            <tr><td>PAOLO vorstellen – Entscheidungspräsentation</td><td>0.4</td><td>27.11.2026</td><td>Lizenzhinweis CC BY 4.0, Namensnennung und Hinweis auf KI-generierte Inhalte ergänzt</td></tr>
            <tr><td>PAOLO vorstellen – Entscheidungspräsentation</td><td>0.3</td><td>18.11.2026</td><td>Verweis auf ein Repository und „open-source" entfernt, Kontaktangabe ergänzt, Schreibfehler korrigiert</td></tr>
            <tr><td>Einführung und Betrieb von PAOLO SMS</td><td>1.2</td><td>28.11.2026</td><td>Lizenzhinweis CC BY 4.0 und Namensnennung ergänzt</td></tr>
            <tr><td>Einführung und Betrieb von PAOLO SMS</td><td>1.1</td><td>18.11.2026</td><td>Verweise auf ein Repository durch das Quellpaket ersetzt</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="nutzung" aria-labelledby="h-nutzung">
    <div class="wrap">
      <h2 id="h-nutzung">Nutzung der Materialien</h2>
      <p>Die Software PAOLO SMS steht unter der GPL-3.0-or-later. Name und Logo sind vom Lizenzrecht ausgenommen und gesondert vorbehalten.</p>
      <p>Die als Download bereitgestellten PDF-Dokumente stehen, soweit im jeweiligen Dokument nicht anders gekennzeichnet, unter der Lizenz <a href={MATERIAL_LICENSE.href}>{MATERIAL_LICENSE.name}</a>. Du darfst sie für beliebige Zwecke teilen und bearbeiten, auch kommerziell.</p>
      <p>Als Namensnennung ist <strong>{MATERIAL_LICENSE.attribution}</strong> anzugeben. Verweise außerdem auf die Lizenz und kennzeichne eigene Änderungen. Marken- und Kennzeichenrechte an Namen und Logos sowie Rechte Dritter bleiben unberührt.</p>
      <p>Dokumente mit KI-generierten Diagrammen oder Illustrationen weisen dies im Dokument und in der jeweiligen Materialbeschreibung aus. Die Inhalte wurden vom PAOLO-Team ausgewählt, geprüft und redaktionell bearbeitet.</p>
      <p>Die ausführlichen Hinweise stehen in der <a href={url('/materialien/LIZENZ.txt')}>Lizenzinformation zu den Materialien</a>.</p>
      <p>Fragen zu Materialien oder zur Weitergabe? <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>
</Base>
